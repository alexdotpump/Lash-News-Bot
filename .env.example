# ----- Required -----
DISCORD_BOT_TOKEN=your_discord_bot_token_here
NEWS_API_KEY=your_newsapi_key_here

# ----- Optional -----
# NewsAPI language for the market-driven query (default: en).
NEWS_LANGUAGE=en
# News provider adapter. Only "NewsAPI" is supported without additional setup; it is
# also the default fallback, so this can normally be left unset. Adding another
# provider requires wiring an adapter plus its own key (not enabled by default).
# NEWS_SOURCE=NewsAPI
# Seconds between monitoring cycles; must be >= 60 (default: 300).
NEWS_POLL_INTERVAL_SECONDS=300
# Legacy fallback alert channel for the server it belongs to.
DISCORD_CHANNEL_ID=optional_channel_id
# Development server IDs (comma separated) that get instant command sync.
# Useful while testing: Discord can take up to an hour to propagate global commands.
DISCORD_DEV_GUILD_ID=optional_dev_guild_id
DISCORD_GUILD_IDS=optional_comma_separated_guild_ids
# Correlation policy for news alerts. The defaults are the balanced setting:
# a clear link to a market posts, a merely contextual story needs a much higher score.
# NEWS_CORRELATION_ALERT_THRESHOLD=60
# A contextual match (a shared subject with no concrete development) needs this many
# points more before it is posted.
# NEWS_CORRELATION_CONTEXTUAL_MARGIN=15
# Matches at or above this score are logged as "near miss" lines for tuning.
# NEWS_CORRELATION_DIAGNOSTICS_THRESHOLD=45
# How many shared ordinary words count as a link when no named entity is shared.
# NEWS_MIN_SUBSTANTIVE_TERMS=2
# Require the linking evidence to be in the article headline. Turning this off
# increases volume and noise: NewsAPI body text contains site furniture and
# related-article links.
# NEWS_REQUIRE_HEADLINE_EVIDENCE=true
# Bootstrap a channel for a category nobody has run /set-...-alerts for, e.g.
# news=123456789012345678,whale=234567890123456789
# ALERT_CHANNEL_FALLBACKS=
# Directory for the persistent state files (guild settings, dedupe history).
# Point this at a mounted volume, otherwise every redeploy wipes per-server settings.
STATE_DIR=/data

# ----- X/Twitter tracking -----
# App-only bearer token for the official X API v2 (api.x.com/2). Without it the
# /xtrack commands still register and explain themselves, but no monitoring runs.
# Reading user timelines requires v2 read access (Basic tier or above); the Free
# tier cannot read timelines.
# X_API_BEARER_TOKEN=
